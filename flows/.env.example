# Local n8n canvas for the conversation graph.
# Copy to flows/.env and set OPENAI_API_KEY before starting.

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_EVAL_MODEL=
OPENAI_TEMPERATURE=0.7
OPENAI_MAX_TOKENS=1000
OPENAI_BASE_URL=
RAG_ENABLED=true
N8N_ENCRYPTION_KEY=careersim-local-n8n
# Assistant agent sandbox. These match the compose defaults.
SANDBOX_API_KEY=careersim-local-sandbox
SANDBOX_REGISTRATION_TOKEN=careersim-local-sandbox-reg
SANDBOX_RUNNER_API_KEY=careersim-local-sandbox-runner
