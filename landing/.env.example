LANDING_SITE_NAME=careersim.local
LANDING_SITE_URL=https://careersim.local
LANDING_GITHUB_URL=https://github.com/lf1up/careersim
# Leave unset to hide LinkedIn from the footer (icon + Resources link).
LANDING_LINKEDIN_URL=https://www.linkedin.com/in/lf1up
LANDING_APP_URL=https://careersim.local/register
LANDING_SIMULATIONS_URL=https://careersim.local/simulations
# Header/footer pricing links. Disabled by default; only true/1 enables them.
# Rebuild landing after changing. Match NEXT_PUBLIC_PRICING_ENABLED in web.
# Contact forms and links stay available.
LANDING_PRICING_ENABLED=false
# Show the creator beta section only when the creator is live in the app.
# Build-time flag: true/1 enables it; false/0/unset hides it. Rebuild to change.
LANDING_CREATOR_ENABLED=false
# Absolute URL for Blog nav/footer links. Leave unset (default) to hide Blog
# links — match web when NEXT_PUBLIC_BLOG_ENABLED is unset/false or Ghost is
# not configured. Example when the blog is live:
# LANDING_BLOG_URL=http://localhost:3000/blog
LANDING_CONTACT_EMAIL=hello@careersim.local

# --------------------------------------------------------------------
# /business contact form delegates to the canonical web project's /api/*
# routes using LANDING_SITE_URL above. Set it to https://careersim.ai for
# production or http://localhost:3000 when developing the landing directly.
# The web handler owns Resend delivery and the API owns CAPTCHA consumption.
# --------------------------------------------------------------------
# Must match web and API. Authenticates forwarded visitor-IP metadata.
ALTCHA_HMAC_KEY=
