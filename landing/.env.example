# Absolute URL for Blog nav/footer links. Leave unset (default) to hide Blog
# links — match web when NEXT_PUBLIC_BLOG_ENABLED is unset/false or Ghost is
# not configured. Example when the blog is live:
# LANDING_BLOG_URL=http://localhost:3000/blog
LANDING_CONTACT_EMAIL=hello@careersim.local

# --------------------------------------------------------------------
# /business contact form — OPTIONAL here. Production on careersim.ai
# uses the `web` package (see the NEW block in web/.env.example). These
# landing vars only matter when hitting the Astro deploy directly
# (e.g. *.vercel.app or `pnpm dev` in landing/).
# --------------------------------------------------------------------
# Resend API key for delivering contact-form inquiries.
# https://resend.com/api-keys
RESEND_API_KEY=
# Verified sender for inquiry emails. Defaults to Resend's shared
# onboarding@resend.dev until a domain sender is verified.
CONTACT_FROM_EMAIL=
# ALTCHA proof-of-work spam protection for the /business contact form.
# Independent from api's ALTCHA_HMAC_KEY — landing challenge + verify only
# need to share THIS value. Use 32+ chars of entropy, e.g.
# `openssl rand -hex 32`.
ALTCHA_HMAC_KEY=
# PoW difficulty target. 50_000 matches the api default.
ALTCHA_MAX_NUMBER=50000
