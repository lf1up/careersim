NODE_ENV=development
HOST=0.0.0.0
PORT=8000
LOG_LEVEL=info

# Version segment prefixed to versioned routes (service index, readiness
# health, docs, auth, sessions, voice, and the internal worker routes).
# Empty/unset means NO prefix — the bare-container default used by the
# current cloud setup. Process liveness (`GET /health`) is never prefixed.
# Locally (pnpm dev and docker-compose.local.yml) keep it at v1, and keep
# the /v1 path in the web app's NEXT_PUBLIC_API_URL and the agent-voice
# worker's API_VERSION_PREFIX in sync with it.
# Accepts "1", "v1" or "/v1" equivalently.
API_VERSION_PREFIX=v1

DATABASE_URL=postgres://careersim:careersim_password@localhost:5432/careersim

AGENT_API_URL=http://localhost:8001

# Shared secret sent as `X-Internal-Key` on every API ⇒ agent call.
# Must match the `AGENT_INTERNAL_KEY` on the agent service. The value
# below is a development placeholder so `docker compose up` works out
# of the box with enforcement on; replace both sides with a real
# secret (e.g. `openssl rand -hex 32`) before any shared / prod deploy.
# Leave empty to let the agent fall back to unauthenticated mode (the
# agent logs a warning on startup).
AGENT_INTERNAL_KEY=dev-internal-key-change-me-openssl-rand-hex-32

JWT_SECRET=change-me-in-prod-this-must-be-a-long-random-string
JWT_EXPIRES_IN=7d

# Public origin of the Next.js web app. Embedded in outbound emails
# (magic-link sign-in, password reset) so users land on the right host.
WEB_APP_URL=http://localhost:3000

# Comma-separated browser origins allowed to call the API. Leave empty
# to keep CORS wide open, matching the default local/dev behavior.
CORS_ALLOWED_ORIGINS=

# --------------------------------------------------------------------
# Outbound email (nodemailer)
#
# Leave SMTP_HOST empty in development to log rendered emails to the
# API's logger instead of sending them — you can copy the 6-digit
# verification code / magic link straight out of `pnpm dev` output.
#
# In production, fill in a real SMTP relay (SendGrid, Postmark, AWS
# SES, Mailgun, etc.) — hostname, port, TLS flag, and credentials.
# --------------------------------------------------------------------
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=careersim.local <no-reply@careersim.local>
MAIL_PRODUCT_NAME=careersim.local

# --------------------------------------------------------------------
# ALTCHA (proof-of-work CAPTCHA) — protects /v1/auth/register, /v1/auth/login,
# /v1/auth/login/email-link, /v1/auth/forgot-password. (/v1/auth/resend-verification
# is intentionally ungated: its pending record can only be created by the
# captcha-gated /v1/auth/register, and abuse is capped by a 3/hour per-mailbox
# rate limit.)
#
# ALTCHA_HMAC_KEY is a server-only secret used to sign + verify
# challenges. Rotating invalidates in-flight challenges. Use 32+ chars
# of entropy (e.g. `openssl rand -hex 32`).
#
# ALTCHA_MAX_NUMBER controls the proof-of-work target. Higher values =
# slower browser solve time. 50_000 is a sensible default for
# interactive auth flows; raise under attack, lower for low-power
# clients.
# --------------------------------------------------------------------
ALTCHA_HMAC_KEY=change-me-to-a-long-random-string-for-altcha
ALTCHA_MAX_NUMBER=50000

# --------------------------------------------------------------------
# Rate limiting (@fastify/rate-limit)
#
# Sustained-request ceiling layered on top of ALTCHA (per-request cost)
# and argon2id (credential brute-force defence). Policies per route
# live in src/plugins/rate-limit.ts; the 200/min global default here
# is the per-IP safety net for any route without an explicit policy.
#
# RATE_LIMIT_ENABLED=false disables the plugin entirely. Useful during
# incidents where the limit itself is an availability problem, or for
# local load tests.
#
# REDIS_URL points at a Redis instance (e.g. the `redis` service from
# docker-compose.local.yml) so buckets are shared across horizontally
# scaled API pods. Leave empty to fall back to a per-process in-memory
# LRU store — fine for single-instance / dev.
# --------------------------------------------------------------------
RATE_LIMIT_ENABLED=true
REDIS_URL=redis://localhost:6379

# --------------------------------------------------------------------
# Session creation quota (per authenticated user)
#
# Each new chat session spins up an agent thread and burns LLM tokens,
# so we cap new-session creation aggressively by default. Raise these
# for internal/demo environments; keep them tight in production.
#
# SESSIONS_CREATE_WINDOW accepts anything @fastify/rate-limit parses —
# e.g. '30 minutes', '1 hour', '6 hours', or a raw milliseconds number.
# --------------------------------------------------------------------
SESSIONS_CREATE_MAX=2
SESSIONS_CREATE_WINDOW=6 hours

# Shared text-message allowance per user across simulations and playgrounds.
# Each item in a batched send counts. The existing 60 requests/minute
# burst limit also applies. Voice uses VOICE_DAILY_MINUTES_PER_USER.
CHAT_MESSAGES_MAX=350
CHAT_MESSAGES_WINDOW=6 hours

# --------------------------------------------------------------------
# Build-time plugins
#
# Leave CAREERSIM_PLUGINS empty for a stock build: the fetch step removes
# any previously installed overlays. Set it to a comma-separated
# list of plugin ids to copy those plugins in before `tsc`.
#
# CAREERSIM_PLUGIN_DIR is a local checkout of the plugin source
# (the directory that contains <id>/plugin.json). When it is set, the
# build copies from disk and does not call GitHub. `pnpm dev` polls that
# directory and restarts the API when the plugin files change.
#
# docker-compose.local.yml already does this for local containers: it
# mounts ../careersim-studio/plugins at /plugins, sets
# CAREERSIM_PLUGIN_DIR=/plugins, and defaults CAREERSIM_PLUGINS to
# `creator`. Override the host path with CAREERSIM_PLUGIN_HOST_DIR, or
# set CAREERSIM_PLUGINS empty in the shell / a repo-root `.env` to boot
# without plugins. Those compose values replace the ones in this file.
#
# For `pnpm dev` on the host (cwd is api/), point at the same checkout:
#   CAREERSIM_PLUGINS=creator
#   CAREERSIM_PLUGIN_DIR=../../careersim-studio/plugins
#
# Otherwise the build downloads
# https://api.github.com/repos/lf1up/careersim-studio/tarball/$CAREERSIM_PLUGIN_REF
# with CAREERSIM_PLUGIN_TOKEN. The token is a fine-grained PAT with
# read-only Contents access to that one repo. Pass it as a BuildKit secret
# (`careersim_plugin_token`) so it never lands in an image layer; the ARG of
# the same name is only a fallback for builders without secrets. It is not
# read at runtime.
# --------------------------------------------------------------------
CAREERSIM_PLUGINS=
CAREERSIM_PLUGIN_DIR=
CAREERSIM_PLUGIN_REF=
CAREERSIM_PLUGIN_TOKEN=

# --------------------------------------------------------------------
# Creator plugin (runtime, only when that plugin was built in)
#
# CUSTOM_SIMULATIONS_MAX is a hard cap on how many custom simulations one
# user can keep (drafts, published, and suspended). Deleting one frees a
# slot. 0 stops new simulations and leaves existing ones working.
#
# Playground starts use SESSIONS_CREATE_MAX / SESSIONS_CREATE_WINDOW.
# Turns, proactive replies, and debriefs use the ordinary conversation
# rate-limit policies.
#
# CREATOR_MODERATION_API_KEY turns on a publish-time content check. Leave it
# empty to skip the check. This example uses OpenRouter; MODEL defaults to
# omni-moderation-latest.
# --------------------------------------------------------------------
CUSTOM_SIMULATIONS_MAX=3
CUSTOM_PERSONAS_MAX=10

# TODO: Move this kind of jobs to the agent service, call with the API
CREATOR_MODERATION_API_KEY=
CREATOR_MODERATION_BASE_URL=https://openrouter.ai/api/v1
CREATOR_MODERATION_MODEL=omni-moderation-latest

# --------------------------------------------------------------------
# Voice mode
#
# Enables the browser-native voice surface (POST /v1/sessions/:id/voice/*).
# When `false` the routes register but return `503 voice_disabled` so
# the kill switch works without redeploying. Mirrors `VOICE_ENABLED` on
# the agent side; both should usually be flipped together.
#
# `LIVEKIT_*` is the self-hosted LiveKit SFU brought up by
# `docker-compose.local.yml`. The API uses these credentials to mint
# short-lived join tokens for the web client. They MUST match the
# values configured on the `livekit` and `agent` services.
#
# `VOICE_DAILY_MINUTES_PER_USER` is the per-user-per-day quota
# enforced by the `voice_minute_usage` table; layered on top of the
# `voiceStart` rate-limit policy in `src/plugins/rate-limit.ts`. The
# debit is authoritative from the agent-voice worker (server-side
# clock), and the worker hard-disconnects a call once the remaining
# budget is spent — so this is now a true per-day ceiling, not just a
# start-time gate.
#
# `VOICE_ACTIVE_CALL_STALE_SECONDS` backs the single-active-call guard
# that stops a user opening N tabs to run N concurrent calls. An
# un-ended call row older than this is treated as a crashed worker
# (so the user isn't locked out); set to 0 to disable the guard.
# --------------------------------------------------------------------
VOICE_ENABLED=true
VOICE_DAILY_MINUTES_PER_USER=60
VOICE_ACTIVE_CALL_STALE_SECONDS=4200

LIVEKIT_URL=ws://livekit:7880
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=devsecret-min-32-chars-change-me-openssl-rand-hex-32

# LiveKit Agents worker HTTP health (GET `/`). Versioned `/v1/health`
# pings this when VOICE_ENABLED is true; empty → `voice: skipped`.
# Host `pnpm dev` uses the published port; compose overrides this to
# `http://agent-voice:8081` on the Docker network.
VOICE_WORKER_URL=http://localhost:8081
