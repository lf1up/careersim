{
  "name": "careersim-api",
  "version": "1.2.0",
  "description": "CareerSIM Fastify + Drizzle API gateway in front of the LangGraph agent service.",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "packageManager": "pnpm@10.29.3",
  "main": "dist/index.js",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "node scripts/plugins.mjs fetch && tsc -p tsconfig.build.json && node scripts/plugins.mjs assets",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint \"src/**/*.ts\" \"tests/**/*.ts\"",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "e2e": "tsx scripts/e2e-flow.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/db/migrate.ts",
    "db:migrate:prod": "node dist/db/migrate.js",
    "db:studio": "drizzle-kit studio"
  },
  "dependencies": {
    "@fastify/cookie": "^11.1.3",
    "@fastify/cors": "^11.3.1",
    "@fastify/jwt": "^10.2.5",
    "@fastify/rate-limit": "^10.3.0",
    "@fastify/sensible": "^6.0.7",
    "@fastify/swagger": "^9.9.2",
    "altcha-lib": "^2.8.0",
    "argon2": "^0.44.0",
    "drizzle-orm": "^0.45.4",
    "eventsource-parser": "^3.0.8",
    "fastify": "^5.12.6",
    "fastify-plugin": "^5.1.0",
    "fastify-type-provider-zod": "^6.1.0",
    "ioredis": "^5.10.1",
    "livekit-server-sdk": "^2.19.2",
    "nodemailer": "^10.2.1",
    "pg": "^8.23.1",
    "pino": "^10.4.0",
    "pino-pretty": "^13.2.0",
    "undici": "^8.12.3",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.4.5",
    "@types/node": "^25.6.0",
    "@types/pg": "^8.23.1",
    "@typescript-eslint/eslint-plugin": "^8.72.0",
    "@typescript-eslint/parser": "^8.72.0",
    "@vitest/coverage-v8": "^4.1.12",
    "drizzle-kit": "^0.31.11",
    "eslint": "^10.13.0",
    "prettier": "^3.9.10",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "vite": "^8.3.5",
    "vitest": "^4.1.12"
  }
}
